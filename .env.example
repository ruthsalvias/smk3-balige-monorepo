# ============================================================
# APLIKASI — SATU PORT UNTUK SEMUANYA
# ============================================================
# Port publik yang dibuka container gateway di host.
APP_PORT=7080
# Origin yang dipakai pengguna di browser. WAJIB persis (skema + host + port).
# Contoh produksi: https://smkn3balige.sch.id
PUBLIC_ORIGIN=http://localhost:7080

NODE_ENV=production

# ============================================================
# AUTENTIKASI (api-gateway)
# ============================================================
# Kunci penandatangan token login. WAJIB diganti, minimal 32 karakter acak.
# Contoh pembuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Masa berlaku sesi login dalam detik (default 8 jam).
JWT_EXPIRES_SECONDS=28800

# Akun master admin pertama, dibuat otomatis saat container pertama kali jalan.
MASTER_ADMIN_USERNAME=masteradmin
MASTER_ADMIN_PASSWORD=ganti-password-master-admin
MASTER_ADMIN_NAMA=Master Admin

# ============================================================
# API GATEWAY
# ============================================================
# Rahasia untuk memastikan service hanya menerima request dari api-gateway.
INTERNAL_GATEWAY_SECRET=ganti-dengan-string-acak-panjang

SERVICE_PELANGGARAN_URL=http://service-pelanggaran:3001
SERVICE_PROFILE_URL=http://service-profile:3002
SERVICE_BERITA_URL=http://service-berita:3003
SERVICE_PORTOFOLIO_URL=http://service-portofolio:3004
SERVICE_MANAGEMENT_URL=http://service-management:3005

SERVICE_PELANGGARAN_PORT=3001
SERVICE_PROFILE_PORT=3002
SERVICE_BERITA_PORT=3003
SERVICE_PORTOFOLIO_PORT=3004
SERVICE_MANAGEMENT_PORT=3005

# ============================================================
# DATABASE
# ============================================================
# Satu definisi untuk semua service. URL disusun di docker-compose.yml sebagai:
# postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_USERNAME=postgres
DB_PASSWORD=ganti-password-postgres
DB_HOST=db_pkm_smk3_balige
DB_PORT=5432
DB_NAME=db_smk3
